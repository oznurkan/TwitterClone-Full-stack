SERVER_PORT=8080
CONTEXT_PATH=/api

DB_NAME=twitterdb
DB_URL=jdbc:postgresql://db:5432/twitterdb
DB_USERNAME=db_username
DB_PASSWORD=db_password

# Localdeki veritabanı ile çalışılıyorsa
# db_name = Veritabanı sunucusundaki veritabanı ismi
# db_port = Veritabanının dış dünya ile iletişimde olduğu port, default 5432
# DB_URL=jdbc:postgresql://localhost:db_port/db_name
